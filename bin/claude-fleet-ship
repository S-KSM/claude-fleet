#!/usr/bin/env bash
# claude-fleet-ship: Push active branches and open GitHub Draft PRs
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=claude-fleet-common.sh
source "$SCRIPT_DIR/claude-fleet-common.sh"

require_repo
load_fleet_config

if [ ! -d "$WORKTREE_ROOT" ]; then
  echo "No active .worktrees directory found."
  exit 0
fi

for dir in "$WORKTREE_ROOT"/*; do
  [ -d "$dir" ] || continue
  SLUG="$(basename "$dir")"
  BRANCH="agent/$SLUG"

  COMMITS_AHEAD=$(git -C "$dir" rev-list --count "$MAIN_BRANCH..HEAD" 2>/dev/null || echo "0")
  if [ "$COMMITS_AHEAD" -gt 0 ]; then
    echo "==> Pushing branch $BRANCH to origin..."
    git -C "$dir" push origin "$BRANCH" --force-with-lease

    if command -v gh &>/dev/null; then
      echo "==> Opening Draft PR for $BRANCH..."
      PR_URL="$(cd "$dir" && gh pr create --fill --draft)" || PR_URL=""
      if [ -n "$PR_URL" ]; then
        echo "$PR_URL"
        sync_plan_pr "$SLUG" "$PR_URL" || true
      fi
    else
      echo "==> Notice: gh CLI not installed. Skipping PR generation."
    fi
  else
    echo "==> Skipping $SLUG (0 commits ahead of $MAIN_BRANCH)."
  fi
done

echo ""
echo "All tasks pushed. Review PRs, then run 'claude-fleet-clean' when finished."
