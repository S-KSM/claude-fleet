#!/usr/bin/env bash
# claude-fleet: Spin up parallel Claude Code instances using Git worktrees and tmux
set -e

if [ "$#" -lt 1 ]; then
  echo "Usage: claude-fleet \"<task 1>\" [\"task 2\" ...]"
  echo "Example: claude-fleet \"auth modal\" \"photo feed\" \"fix-cors\""
  exit 1
fi

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=claude-fleet-common.sh
source "$SCRIPT_DIR/claude-fleet-common.sh"

require_repo
require_no_session
mkdir -p "$WORKTREE_ROOT"
ensure_gitignore

FIRST=true
while [ "$#" -gt 0 ]; do
  TASK_RAW="$1"
  TASK="$(slugify "$TASK_RAW")"
  if [ -z "$TASK" ]; then
    echo "Error: task \"$TASK_RAW\" produced an empty slug. Skipping." >&2
    shift
    continue
  fi
  TREE_DIR="$WORKTREE_ROOT/$TASK"

  if ! ensure_worktree "$TREE_DIR" "agent/$TASK"; then
    shift
    continue
  fi
  [ -f "$BASE_DIR/.env" ] && cp "$BASE_DIR/.env" "$TREE_DIR/.env"

  if [ "$FIRST" = true ]; then
    tmux new-session -d -s "$SESSION_NAME" -c "$TREE_DIR"
    FIRST=false
  else
    tmux split-window -t "$SESSION_NAME" -c "$TREE_DIR"
  fi
  tmux send-keys -t "$SESSION_NAME" "claude" C-m
  shift
done

if [ "$FIRST" = true ]; then
  echo "Error: no valid tasks to launch." >&2
  exit 1
fi

tmux select-layout -t "$SESSION_NAME" tiled
tmux attach-session -t "$SESSION_NAME"
