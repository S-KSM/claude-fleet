#!/usr/bin/env bash
# claude-fleet-start: Automated batch provisioning from a task manifest
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=claude-fleet-common.sh
source "$SCRIPT_DIR/claude-fleet-common.sh"

require_repo
require_no_session

# 1. Sync main branch, restoring wherever HEAD was (including detached),
# even if the pull itself fails.
echo "==> Syncing $MAIN_BRANCH branch..."
ORIGINAL_REF="$(git symbolic-ref --quiet --short HEAD || git rev-parse HEAD)"
git checkout "$MAIN_BRANCH"
git pull --ff-only || echo "Warning: failed to update $MAIN_BRANCH; continuing with the local copy." >&2
[ "$ORIGINAL_REF" != "$MAIN_BRANCH" ] && git checkout "$ORIGINAL_REF"

mkdir -p "$WORKTREE_ROOT"
ensure_gitignore

TASK_FILE="${1:-tasks.txt}"
if [ ! -f "$TASK_FILE" ]; then
  echo "Error: No task file found at '$TASK_FILE'." >&2
  echo "Format per line: slug | Initial prompt for Claude" >&2
  exit 1
fi

FIRST=true
while IFS="|" read -r RAW_SLUG PROMPT || [ -n "$RAW_SLUG" ]; do
  RAW_SLUG="$(echo "$RAW_SLUG" | sed 's/^[ \t]*//;s/[ \t]*$//')"
  [[ "$RAW_SLUG" =~ ^#.*$ ]] && continue
  [ -z "$RAW_SLUG" ] && continue

  SLUG=$(echo "$RAW_SLUG" | tr '[:upper:]' '[:lower:]' | tr ' ' '-' | tr -cd '[:alnum:]-_')
  PROMPT=$(echo "$PROMPT" | sed 's/^[ \t]*//;s/[ \t]*$//')
  TREE_DIR="$WORKTREE_ROOT/$SLUG"

  echo "==> Provisioning workspace: $SLUG"
  IS_NEW=false
  if ! git worktree list --porcelain | grep -qx "worktree $TREE_DIR"; then
    IS_NEW=true
  fi
  if ! ensure_worktree "$TREE_DIR" "agent/$SLUG"; then
    continue
  fi
  [ "$IS_NEW" = true ] && [ -f "$BASE_DIR/.env" ] && cp "$BASE_DIR/.env" "$TREE_DIR/.env"

  if [ "$FIRST" = true ]; then
    tmux new-session -d -s "$SESSION_NAME" -c "$TREE_DIR"
    FIRST=false
  else
    tmux split-window -t "$SESSION_NAME" -c "$TREE_DIR"
  fi

  # Run dependency install (if any) inside the pane itself, ahead of
  # launching claude, so installs across panes overlap instead of
  # blocking this provisioning loop one worktree at a time.
  INSTALL_CMD=""
  [ "$IS_NEW" = true ] && INSTALL_CMD="$(install_cmd_for "$TREE_DIR")"
  if [ -n "$INSTALL_CMD" ]; then
    tmux send-keys -t "$SESSION_NAME" "$INSTALL_CMD && claude" C-m
  else
    tmux send-keys -t "$SESSION_NAME" "claude" C-m
  fi
  if [ -n "$PROMPT" ]; then
    tmux send-keys -t "$SESSION_NAME" "$PROMPT" C-m
  fi
done < "$TASK_FILE"

if [ "$FIRST" = true ]; then
  echo "Error: no valid tasks found in '$TASK_FILE'." >&2
  exit 1
fi

tmux select-layout -t "$SESSION_NAME" tiled
echo "==> Fleet running in background. Connect with: tmux attach -t claude-fleet"
